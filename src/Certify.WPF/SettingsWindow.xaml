<Window x:Class="Certify.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_Settings_Title}" Height="600" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings_Header}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                <TextBlock Text="{DynamicResource Settings_Header_Sub}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Sec_General}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Settings_Lang}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LangBox" Grid.Column="1" ToolTip="{DynamicResource Settings_Tip_Lang}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Sec_Email}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                    <CheckBox x:Name="EnabledCheck" Content="{DynamicResource Settings_Enable}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Settings_Host}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,0,0,10" ToolTip="np. smtp.gmail.com, smtp.office365.com"/>
                        <TextBlock Text="{DynamicResource Settings_Port}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="1" Margin="0,0,0,10"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PortBox"/>
                            <CheckBox x:Name="SslCheck" Content="SSL/TLS" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Settings_User}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="2" Margin="0,0,0,10"/>
                        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Settings_Pass}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="3" Margin="0,0,0,10"/>
                        <PasswordBox x:Name="PassBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Background="#0F1A31" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="10,7"/>
                        <TextBlock Text="{DynamicResource Settings_From}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="4" Margin="0,0,0,10"/>
                        <TextBox x:Name="FromBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Settings_To}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="5" Margin="0,0,0,10"/>
                        <TextBox x:Name="ToBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" ToolTip="{DynamicResource Settings_Tip_To}"/>
                        <TextBlock Text="{DynamicResource Settings_WarnDays}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="6" Margin="0,0,0,10"/>
                        <TextBox x:Name="WarnDaysBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" ToolTip="{DynamicResource Settings_Tip_Warn}"/>
                        <TextBlock Text="" Grid.Row="7"/>
                        <Button Content="{DynamicResource Settings_Btn_Test}" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" MinWidth="140" Click="Test_Click"/>
                    </Grid>
                    <TextBlock x:Name="TestResult" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Border Background="#0F1A31" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <TextBlock Text="{DynamicResource Settings_Hint_Gmail}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0A1120" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Settings_Footer}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Btn_Cancel}" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="{DynamicResource Btn_Save}" MinWidth="120" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
