<Window x:Class="Certify.WPF.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_Task_Title}" Height="560" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Task_Header_Kicker}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Task_Header_Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Task_Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Task_Type}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="1" Margin="0,0,0,10"/>
                        <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" SelectionChanged="TypeBox_SelectionChanged"/>
                        <TextBlock Text="{DynamicResource Task_Stage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="2" Margin="0,0,0,10"/>
                        <ComboBox x:Name="StageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" SelectionChanged="StageBox_SelectionChanged"/>
                        <TextBlock Text="{DynamicResource Task_Trigger}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Grid.Row="3" Margin="0,0,0,10"/>
                        <ComboBox x:Name="TriggerBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>
                        <CheckBox x:Name="EnabledCheck" Content="{DynamicResource Task_Enabled}" Grid.Row="4" Grid.Column="1"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Task_Params}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,10"/>
                    <StackPanel x:Name="ParamsPanel"/>
                    <TextBlock Text="{DynamicResource Task_VarsHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0A1120" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="LastRunText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Btn_Cancel}" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="{DynamicResource Btn_Save}" MinWidth="120" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
