<Window x:Class="Certify.WPF.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Win_Service_Title}" Height="400" Width="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Svc_Kicker}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Svc_Intro}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Svc_Row_Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                <TextBlock x:Name="StatusValue" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="{DynamicResource Svc_Row_Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                <TextBlock x:Name="NameValue" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Text="{DynamicResource Svc_Row_Dir}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                <TextBlock x:Name="DirValue" Grid.Row="2" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource Svc_Row_Files}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="FilesValue" Grid.Row="3" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0A1120" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="InstallButton" Content="{DynamicResource Svc_Btn_Install}" Padding="12,6" Margin="0,0,6,0" Click="Install_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="UpdateButton" Content="{DynamicResource Svc_Btn_Update}" Padding="12,6" Margin="0,0,6,0" Click="Update_Click"/>
                    <Button x:Name="StartButton" Content="{DynamicResource Svc_Btn_Start}" Padding="12,6" Margin="0,0,6,0" Click="Start_Click"/>
                    <Button x:Name="StopButton" Content="{DynamicResource Svc_Btn_Stop}" Padding="12,6" Margin="0,0,6,0" Click="Stop_Click"/>
                    <Button x:Name="UninstallButton" Content="{DynamicResource Svc_Btn_Uninstall}" Padding="12,6" Click="Uninstall_Click"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Btn_Close}" MinWidth="90" Click="Close_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
