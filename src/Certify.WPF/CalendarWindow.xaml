<Window x:Class="Certify.WPF.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Certify.WPF"
        Title="{DynamicResource Win_Cal_Title}" Height="640" Width="860" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button local:ButtonIcon.Kind="Prev" Content="" Width="40" Click="Prev_Click" Margin="0,0,8,0"/>
                    <Button local:ButtonIcon.Kind="Today" Content="{DynamicResource Cal_Today}" MinWidth="70" Click="Today_Click"/>
                    <Button local:ButtonIcon.Kind="Next" Content="" Width="40" Margin="8,0,0,0" Click="Next_Click"/>
                </StackPanel>
                <TextBlock x:Name="MonthTitle" Grid.Column="1" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Cal_Legend_Ren}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Cal_Legend_Exp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Dow0" Grid.Column="0" Text="Pn" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow1" Grid.Column="1" Text="Wt" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow2" Grid.Column="2" Text="Śr" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow3" Grid.Column="3" Text="Cz" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow4" Grid.Column="4" Text="Pt" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow5" Grid.Column="5" Text="Sb" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Dow6" Grid.Column="6" Text="Nd" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="10" SnapsToDevicePixels="True">
            <Grid x:Name="DaysGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#0A1120" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CalendarFooter" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <Button local:ButtonIcon.Kind="Close" Grid.Column="1" Content="{DynamicResource Btn_Close}" MinWidth="120" Click="Close_Click" IsCancel="True" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
