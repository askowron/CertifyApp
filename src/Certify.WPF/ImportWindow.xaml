<Window x:Class="Certify.WPF.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Certify.WPF"
        Title="{DynamicResource Win_Import_Title}" Height="420" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Import_Kicker}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="ImportFile" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16" SnapsToDevicePixels="True">
            <StackPanel>
                        <TextBlock Text="{DynamicResource Import_Contents}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="ManifestText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Import_Mode}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,16,0,10"/>
                <ComboBox x:Name="ModeBox" FontSize="12"/>
                <TextBlock x:Name="ModeHint" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Border Background="#0F1A31" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <TextBlock Text="{DynamicResource Import_Secrets}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#0A1120" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button local:ButtonIcon.Kind="Cancel" Content="{DynamicResource Btn_Cancel}" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button local:ButtonIcon.Kind="Import" Content="{DynamicResource Import_Btn_Do}" MinWidth="120" Click="Import_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
