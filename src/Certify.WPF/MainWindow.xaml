<Window x:Class="Certify.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Certify.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource MainFont}">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0A1120" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="20,22,20,18">
                    <Border Width="42" Height="42" CornerRadius="11" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#22D3EE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="CA" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="CertifyApp" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,14,0,2"/>
                    <TextBlock Text="{DynamicResource Main_Side_Tagline}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,16,0,0" Opacity="0.7"/>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="10,4">
                    <TextBlock Text="{DynamicResource Main_Nav_Manage}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,6,0,10" Opacity="0.8"/>
                    <Border Background="#16233F" CornerRadius="9" Padding="12,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentGradient}" Margin="0,0,10,0">
                                <TextBlock Text="#" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Main_Nav_Certs}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SidebarCountText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom sidebar -->
                <Border Grid.Row="2" Margin="12" Padding="12" CornerRadius="10" Background="#0F1A31" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#16233F" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <TextBlock Text="F" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DataDirText" Text="%ProgramData%\CertifyApp" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                <TextBlock Text="{DynamicResource Main_Side_DataSub}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <Button local:ButtonIcon.Kind="Folder" Content="{DynamicResource Main_Btn_OpenFolder}" Click="OpenFolder_Click" local:Help.Topic="OpenFolder" Margin="0,10,0,0" Padding="0,6" Style="{StaticResource GhostButton}" FontSize="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <!-- Przyciski w kolumnie * + WrapPanel: przy waskim oknie / dluzszym jezyku zawijaja sie zamiast wychodzic poza okno -->
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Main_Top_Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold"/>
                        <Border Background="#16233F" CornerRadius="14" Padding="10,4" Margin="12,4,0,0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderBadge" Text="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button local:ButtonIcon.Kind="Refresh" Content="{DynamicResource Main_Btn_Refresh}" Click="Refresh_Click" local:Help.Topic="Refresh" Padding="12,7" Margin="0,0,8,0"/>
                    <Button local:ButtonIcon.Kind="Schedule" Content="{DynamicResource Main_Btn_TaskSched}" Click="TaskScheduler_Click" Padding="12,7" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_TaskSched}"/>
                    <Button local:ButtonIcon.Kind="Service" Content="{DynamicResource Main_Btn_Service}" Click="Service_Click" Padding="12,7" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Service}"/>
                    <Button local:ButtonIcon.Kind="Settings" Content="{DynamicResource Main_Btn_Settings}" Click="Settings_Click" Padding="12,7" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Settings}"/>
                    <Button local:ButtonIcon.Kind="Calendar" Content="{DynamicResource Main_Btn_Calendar}" Click="Calendar_Click" Padding="12,7" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Calendar}"/>
                    <Button local:ButtonIcon.Kind="Help" Content="{DynamicResource Main_Btn_Help}" Click="Help_Click" Padding="12,7" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Help}"/>
                    <Button local:ButtonIcon.Kind="RenewAll" Content="{DynamicResource Main_Btn_RenewAll}" Click="RenewAll_Click" local:Help.Topic="RenewAll" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                </WrapPanel>
            </Grid>

            <!-- Action bar (bez Effect: cien rozmazywalby tekst w srodku) -->
            <Border Grid.Row="1" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" SnapsToDevicePixels="True" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <Button local:ButtonIcon.Kind="Add" Content="{DynamicResource Main_Btn_New}" Click="NewCert_Click" local:Help.Topic="New" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button local:ButtonIcon.Kind="Edit" Content="{DynamicResource Btn_Edit}" Click="EditCert_Click" local:Help.Topic="Edit" Margin="0,0,8,0"/>
                        <Button local:ButtonIcon.Kind="Delete" Content="{DynamicResource Btn_Delete}" Click="DeleteCert_Click" local:Help.Topic="Delete" Margin="0,0,8,0"/>
                        <Border Width="1" Background="{StaticResource BorderBrush2}" Margin="6,4"/>
                        <Button local:ButtonIcon.Kind="Request" Content="{DynamicResource Main_Btn_Request}" Click="RequestCert_Click" local:Help.Topic="Request" Background="#1E3A2E" BorderBrush="#234E3A" Foreground="#86EFAC" Margin="0,0,8,0" Padding="16,7" FontWeight="Bold"/>
                        <Button local:ButtonIcon.Kind="Test" Content="{DynamicResource Main_Btn_Staging}" Click="TestCert_Click" local:Help.Topic="Staging" Margin="0,0,8,0"/>
                        <Button local:ButtonIcon.Kind="Deploy" Content="{DynamicResource Main_Btn_Deploy}" Click="DeployCert_Click" local:Help.Topic="Deploy" Margin="0,0,8,0"/>
                        <Button local:ButtonIcon.Kind="Export" Content="{DynamicResource Main_Btn_Export}" Click="ExportCert_Click" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Export}"/>
                        <Button local:ButtonIcon.Kind="Preview" Content="{DynamicResource Main_Btn_Preview}" Click="PreviewCert_Click" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Preview}"/>
                        <Button local:ButtonIcon.Kind="Backup" Content="{DynamicResource Main_Btn_Backup}" Click="Backup_Click" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Backup}"/>
                        <Button local:ButtonIcon.Kind="Import" Content="{DynamicResource Main_Btn_Import}" Click="Import_Click" Margin="0,0,8,0" ToolTip="{DynamicResource Main_Tip_Import}"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="ProgressBar" Width="140" Height="6" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="#16233F" BorderThickness="0"/>
                        <Button local:ButtonIcon.Kind="Cancel" x:Name="CancelButton" Content="{DynamicResource Btn_Cancel}" Click="CancelOperation_Click" local:Help.Topic="CancelOp" Visibility="Collapsed" Padding="10,4" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Banner alertow (widoczny tylko gdy sa alerty) -->
            <Border x:Name="AlertsBanner" Grid.Row="2" Background="#2A1A12" CornerRadius="12" BorderBrush="#7C2D12" BorderThickness="1" Padding="12,9" SnapsToDevicePixels="True" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="!" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="AlertsText" Text="" Foreground="#FDBA74" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button local:ButtonIcon.Kind="Info" Grid.Column="1" Content="{DynamicResource Main_Btn_Details}" Click="Alerts_Click" local:Help.Topic="Alerts" Padding="10,4" FontSize="11"/>
                </Grid>
            </Border>

            <!-- Wiersz 2: DataGrid + panel statusu (jak CTW: Status / Certificate / ...) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

            <!-- DataGrid card (bez Effect: cien rozmazywalby tekst w srodku) -->
            <Border Grid.Column="0" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0F1A31" CornerRadius="12,12,0,0" Padding="14,12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource Main_Grid_Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" ToolTip="{DynamicResource Main_Grid_Hint}"/>
                    </Border>
                    <DataGrid x:Name="CertsGrid" local:Help.Topic="CertGrid" Grid.Row="1" Margin="0"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              MouseDoubleClick="CertsGrid_MouseDoubleClick"
                              SelectionChanged="CertsGrid_SelectionChanged"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Grid_Name}" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="{DynamicResource Grid_Domains}" Binding="{Binding DomainsDisplay}" Width="260"/>
                            <DataGridTextColumn Header="CA" Binding="{Binding CertificateAuthority}" Width="110"/>
                            <DataGridTextColumn Header="CHALLENGE" Binding="{Binding ChallengeType}" Width="95"/>
                            <DataGridTextColumn Header="DEPLOY" Binding="{Binding DeploymentDisplay}" Width="110"/>
                            <DataGridTemplateColumn Header="{DynamicResource Grid_Status}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E2A44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Valid"><Setter Property="Background" Value="#0F2E1E"/><Setter Property="BorderBrush" Value="#14532D"/><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="#33151A"/><Setter Property="BorderBrush" Value="#7F1D1D"/><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired"><Setter Property="Background" Value="#331E14"/><Setter Property="BorderBrush" Value="#7C2D12"/><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Grid_Expires}" Binding="{Binding DateExpiryDisplay}" Width="Auto" MinWidth="125"/>
                            <DataGridTextColumn Header="{DynamicResource Grid_Days}" Binding="{Binding DaysUntilExpiry}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource Grid_Message}" Binding="{Binding StatusMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Panel statusu wybranego certyfikatu -->
            <Border Grid.Column="1" Background="{StaticResource CardGradient}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True" Margin="14,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0F1A31" CornerRadius="12,12,0,0" Padding="14,12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource Main_Panel_Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel x:Name="StatusPanel">
                            <TextBlock x:Name="DetailName" Text="{DynamicResource Main_Panel_NoSel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Border x:Name="DetailBadge" CornerRadius="14" Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,4" Background="#1E2A44" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <TextBlock x:Name="DetailBadgeText" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Main_Row_AutoRenew}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailAutoRenew" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="{DynamicResource Main_Row_LastRenewal}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailLastRenewal" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource Main_Row_Expiry}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailExpiry" Grid.Row="2" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource Main_Row_NextRenewal}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailNextRenewal" Grid.Row="3" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="4" Text="{DynamicResource Main_Row_LastCa}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailLastCa" Grid.Row="4" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Main_Row_Lifetime}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar x:Name="LifetimeBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBrush}" Background="#16233F" BorderThickness="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DetailLifetime" Grid.Column="1" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button local:ButtonIcon.Kind="Log" x:Name="OpenCertLogButton" Content="{DynamicResource Main_Btn_OpenLog}" Click="OpenCertLog_Click" local:Help.Topic="OpenLog" Margin="0,0,8,0" Padding="10,6" FontSize="12"/>
                                <Button local:ButtonIcon.Kind="History" Content="{DynamicResource Main_Btn_History}" Click="History_Click" Padding="10,6" FontSize="12" ToolTip="{DynamicResource Main_Tip_History}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>

            <!-- Log (bez Effect: cien rozmazywalby tekst w srodku) -->
            <Border Grid.Row="4" Background="#080E1E" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="0" SnapsToDevicePixels="True" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                    <Border Background="#0F1A31" CornerRadius="12,12,0,0" Padding="12,8" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Main_Log_Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusBarText" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button local:ButtonIcon.Kind="Save" Content="{DynamicResource Main_Btn_SaveLog}" Click="SaveLog_Click" local:Help.Topic="SaveLog" Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                                <Button local:ButtonIcon.Kind="Clear" Content="{DynamicResource Main_Btn_Clear}" Click="ClearLog_Click" local:Help.Topic="ClearLog" Padding="10,5" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="LogBox" local:Help.Topic="LogBox" Grid.Row="1" Margin="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Padding="12"
                             TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
