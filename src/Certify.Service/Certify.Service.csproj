<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <ProjectReference Include="..\Certify.Core\Certify.Core.csproj" />
    <ProjectReference Include="..\Certify.ACME\Certify.ACME.csproj" />
    <ProjectReference Include="..\Certify.Deployment\Certify.Deployment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Microsoft.Web.Administration (przez Certify.Deployment) jest pakietem .NET Framework - jak w aplikacji. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <AssemblyVersion>26.10.5.1</AssemblyVersion>
  </PropertyGroup>

</Project>
