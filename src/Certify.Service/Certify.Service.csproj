<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <ProjectReference Include="..\Certify.Core\Certify.Core.csproj" />
    <ProjectReference Include="..\Certify.ACME\Certify.ACME.csproj" />
    <ProjectReference Include="..\Certify.Deployment\Certify.Deployment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- Microsoft.Web.Administration potrzebuje System.Security.Permissions, ktory w .NET 8 jest tylko we frameworku
       Microsoft.WindowsDesktop.App. Aplikacja WPF go ma, a usluga (kopia katalogu aplikacji) bez tej referencji
       ladowala sie na samym Microsoft.NETCore.App i wdrozenie w IIS konczylo sie FileNotFoundException.
       Wymaganie instalacji (.NET 8 Desktop Runtime) juz zawiera ten framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Microsoft.Web.Administration (przez Certify.Deployment) jest pakietem .NET Framework - jak w aplikacji. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <AssemblyVersion>26.10.29.1</AssemblyVersion>
  </PropertyGroup>

</Project>
